{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/movie/decade/[decade]",
      "regex": "^/movie/decade/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPdecade": "nxtPdecade"
      },
      "namedRegex": "^/movie/decade/(?<nxtPdecade>[^/]+?)(?:/)?$"
    },
    {
      "page": "/movie/genre/[genreName]",
      "regex": "^/movie/genre/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPgenreName": "nxtPgenreName"
      },
      "namedRegex": "^/movie/genre/(?<nxtPgenreName>[^/]+?)(?:/)?$"
    },
    {
      "page": "/movie/year/[year]",
      "regex": "^/movie/year/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPyear": "nxtPyear"
      },
      "namedRegex": "^/movie/year/(?<nxtPyear>[^/]+?)(?:/)?$"
    },
    {
      "page": "/movie/[slug]",
      "regex": "^/movie/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/movie/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/movie/[slug]/stream",
      "regex": "^/movie/([^/]+?)/stream(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/movie/(?<nxtPslug>[^/]+?)/stream(?:/)?$"
    },
    {
      "page": "/person/[id]",
      "regex": "^/person/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/person/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tv-show/genre/[genreName]",
      "regex": "^/tv\\-show/genre/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPgenreName": "nxtPgenreName"
      },
      "namedRegex": "^/tv\\-show/genre/(?<nxtPgenreName>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tv-show/[slug]",
