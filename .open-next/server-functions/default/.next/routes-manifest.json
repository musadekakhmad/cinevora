      "namedRegex": "^/privacy\\-policy(?:/)?$"
    },
    {
      "page": "/rankings",
      "regex": "^/rankings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/rankings(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/rss",
      "regex": "^/rss(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/rss(?:/)?$"
